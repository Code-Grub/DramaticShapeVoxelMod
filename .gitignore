# Bytecode from the authoring tools in tools/ and
# assets/docs/buidling_to_voxel/ -- generated on whatever machine ran them.
__pycache__/
*.py[cod]

# agent worktrees and local scratch
.claude/

# Bring-your-own battle art. Preserve the documented example directory tree,
# but never commit locally supplied artwork, atlases, drafts, or sidecars.
assets/battle/**
!assets/battle/**/
!assets/battle/**/README.md
# Exception: the curated static arena backdrop shipped as a PNG arena option.
!assets/battle/front-static/bosses/arena.png
