# Bytecode from the authoring tools in tools/ and
# assets/docs/buidling_to_voxel/ -- generated on whatever machine ran them.
__pycache__/
*.py[cod]

# agent worktrees and local scratch
.claude/

# Bring-your-own battle art. Keep the contracts/READMEs tracked, but never
# commit locally supplied Pokemon artwork.
assets/battle/front-static/*
!assets/battle/front-static/README.md
assets/battle/back-static/*
!assets/battle/back-static/README.md
assets/battle/front-animated/*
!assets/battle/front-animated/README.md
assets/battle/back-animated/*
!assets/battle/back-animated/README.md
